# Postgres-Zugangsdaten (Container "db")
POSTGRES_USER=pdfdl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdfdl

# Von der App verwendete Verbindungs-URL (async, psycopg3-Treiber)
# Innerhalb von docker-compose zeigt der Host "db" auf den Postgres-Service.
DATABASE_URL=postgresql+psycopg://pdfdl:change-me@db:5432/pdfdl

# Fernet-Schlüssel zur Verschlüsselung von Client-Secrets/Zertifikaten in der DB.
# Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Root-Verzeichnis, in das alle Jobs herunterladen - so sieht die App den Pfad VON INNEN im
# Container. Muss i.d.R. nicht geändert werden (siehe DOWNLOAD_HOST_DIR für den Host-Pfad).
DOWNLOAD_ROOT=/data/Download

# Host-Ordner, der auf DOWNLOAD_ROOT im Container gemappt wird (siehe docker-compose.yml).
# Hier landen die heruntergeladenen Dateien tatsächlich sichtbar auf diesem Rechner/Server.
# Default: ./Download im Projektordner. Für einen anderen Ort z.B.:
#   DOWNLOAD_HOST_DIR=D:/Freigaben/PDF-Ablage        (Windows)
#   DOWNLOAD_HOST_DIR=/srv/pdf-download/ablage        (Linux)
# Nach einer Änderung: "docker compose up -d" (nicht nur "restart"), damit der Container mit
# dem neuen Mount neu erstellt wird - der Zielordner muss vorher existieren.
DOWNLOAD_HOST_DIR=./Download

# UID/GID, zu denen der Container-Prozess beim Start wechselt (App läuft NICHT als root).
# Standardmäßig NICHT gesetzt: der Container erkennt den nötigen Wert automatisch (per "stat")
# vom Besitzer des DOWNLOAD_HOST_DIR-Ordners auf dem Host. Nur für Sonderfälle (z.B. Netzlaufwerk,
# abweichender gewünschter Besitzer) hier manuell setzen - überschreibt dann die Auto-Erkennung.
#PUID=1000
#PGID=1000

# Zeitzone für Statistik-/Kalenderberechnungen (heute/gestern/Woche)
APP_TIMEZONE=Europe/Berlin

# Port der Weboberfläche
PORT=4000

# Optionaler HTTP-Basic-Schutz für die gesamte Weboberfläche (leer = deaktiviert)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Auto-Reload bei Code-Änderungen (im Produktivbetrieb ggf. auf false setzen)
RELOAD=true

LOG_LEVEL=INFO

# Anzahl gleichzeitig laufender Hintergrund-Tasks (Sync/Auswertung/Download). Procrastinate läuft
# standardmäßig mit 1 (streng sequenziell) - bei großen Postfächern mit vielen tausend Nachrichten
# dauert das entsprechend sehr lange, obwohl die Tasks fast nur auf Netzwerkantworten von Graph
# warten und sich gut parallelisieren lassen. Höher setzen (z.B. 20) für spürbar mehr Tempo bei
# großen Postfächern; die Per-Tenant-Begrenzung in app/graph/throttling.py verhindert dabei
# weiterhin ein Throttling durch zu viele gleichzeitige Graph-Aufrufe gegen denselben Tenant.
WORKER_CONCURRENCY=10
